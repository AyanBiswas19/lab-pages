---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Anoop Lab — Computer Vision & Edge AI Research',
  description = 'Publications, project pages, and research artefacts from Anoop Lab.',
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-inner">
        <a href={baseUrl} class="site-brand">
          <span>🔬</span>
          <span>Anoop Lab</span>
        </a>
        <nav class="site-nav">
          <a href={baseUrl}>Research</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer container">
      <p>© {new Date().getFullYear()} Anoop Lab. Published via GitHub Pages.</p>
    </footer>
  </body>
</html>
