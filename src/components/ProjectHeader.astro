---
import ActionButton from './ActionButton.astro';

interface Author {
  name: string;
  url?: string;
  affiliation?: string;
  equalContribution?: boolean;
}

interface Affiliation {
  id: string;
  name: string;
}

interface LinkItem {
  label: string;
  url: string;
  icon?: string;
}

interface Props {
  title: string;
  venue: string;
  authors: Author[];
  affiliations?: Affiliation[];
  links: LinkItem[];
}

const { title, venue, authors, affiliations, links } = Astro.props;
const hasEqualContrib = authors.some((a) => a.equalContribution);
---

<header class="project-header">
  <div class="venue-badge-container">
    <span class="badge venue-badge">{venue}</span>
  </div>

  <h1 class="project-title">{title}</h1>

  <div class="authors-list">
    {
      authors.map((author, index) => (
        <span class="author-item">
          {author.url ? (
            <a href={author.url} target="_blank" rel="noopener noreferrer" class="author-name">
              {author.name}
            </a>
          ) : (
            <span class="author-name">{author.name}</span>
          )}
          {author.affiliation && <sup class="affiliation-marker">{author.affiliation}</sup>}
          {author.equalContribution && <sup class="equal-contrib-marker">*</sup>}
          {index < authors.length - 1 && <span class="author-sep">,</span>}
        </span>
      ))
    }
  </div>

  {
    affiliations && affiliations.length > 0 && (
      <div class="affiliations-list">
        {affiliations.map((aff) => (
          <span class="affiliation-item">
            <sup>{aff.id}</sup> {aff.name}
          </span>
        ))}
      </div>
    )
  }

  {
    hasEqualContrib && (
      <div class="equal-contrib-note">
        <small>* Equal contribution</small>
      </div>
    )
  }

  {
    links && links.length > 0 && (
      <div class="action-buttons">
        {links.map((link) => (
          <ActionButton label={link.label} url={link.url} icon={link.icon} />
        ))}
      </div>
    )
  }
</header>

<style>
  .project-header {
    text-align: center;
    padding: 2rem 0 2.5rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2.5rem;
  }

  .venue-badge-container {
    margin-bottom: 1rem;
  }

  .project-title {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--color-text);
    max-width: 850px;
    margin: 0 auto 1.5rem;
  }

  .authors-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.15rem;
    margin-bottom: 0.75rem;
  }

  .author-item {
    display: inline-flex;
    align-items: baseline;
  }

  .author-name {
    font-weight: 600;
  }

  .affiliation-marker,
  .equal-contrib-marker {
    font-size: 0.75em;
    font-weight: 700;
    color: var(--color-primary);
    margin-left: 1px;
  }

  .author-sep {
    margin-right: 0.25rem;
  }

  .affiliations-list {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .equal-contrib-note {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    font-style: italic;
  }
</style>
