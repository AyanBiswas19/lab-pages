---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  label?: string; // e.g. "Figure 1:"
}

const { src, alt, caption, label } = Astro.props;
---

<figure class="paper-figure">
  <img src={src} alt={alt} loading="lazy" />
  {
    (caption || label) && (
      <figcaption class="paper-caption">
        {label && <strong class="caption-label">{label} </strong>}
        {caption}
      </figcaption>
    )
  }
</figure>

<style>
  .paper-figure {
    margin: 2rem 0;
    text-align: center;
  }

  .paper-figure img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    margin: 0 auto;
  }

  .paper-caption {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-top: 0.75rem;
    line-height: 1.5;
    text-align: left;
    max-width: 90%;
    margin-left: auto;
    margin-right: auto;
  }

  .caption-label {
    color: var(--color-text);
  }
</style>
